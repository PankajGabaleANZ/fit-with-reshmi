{
  "entities": {
    "Client": {
      "title": "Client",
      "description": "User client profile for functional nutrition & wellness consultations",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the client"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Client email address"
        },
        "name": {
          "type": "string",
          "description": "Client full name"
        },
        "history": {
          "type": "string",
          "description": "Clinical health background and notes"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of account creation"
        }
      },
      "required": ["id", "email", "name"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Clinical appointment or consultation booking",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique booking identifier"
        },
        "clientId": {
          "type": "string",
          "description": "Identifier of the client booking the session"
        },
        "clientEmail": {
          "type": "string",
          "format": "email",
          "description": "Email address of the client"
        },
        "clientName": {
          "type": "string",
          "description": "Name of the client"
        },
        "date": {
          "type": "string",
          "description": "Date of appointment (YYYY-MM-DD)"
        },
        "time": {
          "type": "string",
          "description": "Time slot of appointment"
        },
        "notes": {
          "type": "string",
          "description": "Client notes or symptoms"
        },
        "status": {
          "type": "string",
          "enum": ["Upcoming", "Completed", "Cancelled"],
          "description": "Current status of the booking"
        },
        "meetLink": {
          "type": "string",
          "description": "Google Meet or video meeting URL"
        },
        "eventId": {
          "type": "string",
          "description": "Associated Google Calendar event ID"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of booking"
        }
      },
      "required": ["id", "date", "time", "status"]
    },
    "Session": {
      "title": "Session",
      "description": "Clinical session transcription, diagnostics and health plan",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique session record identifier"
        },
        "bookingId": {
          "type": "string",
          "description": "Associated booking identifier"
        },
        "transcription": {
          "type": "string",
          "description": "Audio transcription of consultation"
        },
        "plan": {
          "type": "string",
          "description": "Customized clinical nutrition and breathwork plan"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of session completion"
        }
      },
      "required": ["id", "bookingId"]
    },
    "BreathProtocol": {
      "title": "BreathProtocol",
      "description": "Cadence breathing exercise protocol",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Protocol code identifier (e.g. 478, box)"
        },
        "name": {
          "type": "string",
          "description": "Display name of the protocol"
        },
        "desc": {
          "type": "string",
          "description": "Clinical description and benefits"
        },
        "inhale": {
          "type": "number",
          "description": "Inhale duration in seconds"
        },
        "holdIn": {
          "type": "number",
          "description": "Retention duration in seconds"
        },
        "exhale": {
          "type": "number",
          "description": "Exhale duration in seconds"
        },
        "holdOut": {
          "type": "number",
          "description": "Post-exhale retention duration in seconds"
        },
        "emoji": {
          "type": "string",
          "description": "Emoji icon"
        },
        "animationMode": {
          "type": "string",
          "description": "Visual pacer mode"
        },
        "videoUrl": {
          "type": "string",
          "description": "Ambient background video loop URL"
        },
        "instructionAudio": {
          "type": "string",
          "description": "Audio guidance URL"
        },
        "clinicalNotes": {
          "type": "string",
          "description": "Physiological rationale and indications"
        },
        "sortOrder": {
          "type": "number",
          "description": "Ordering priority"
        }
      },
      "required": ["id", "name", "desc", "inhale", "exhale"]
    },
    "InstagramReel": {
      "title": "InstagramReel",
      "description": "Health education video reel",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique reel ID"
        },
        "title": {
          "type": "string",
          "description": "Video caption or topic"
        },
        "views": {
          "type": "string",
          "description": "View count metric"
        },
        "likes": {
          "type": "string",
          "description": "Like count metric"
        },
        "comments": {
          "type": "number",
          "description": "Comment count metric"
        },
        "thumbnail": {
          "type": "string",
          "description": "Poster image URL"
        },
        "videoUrl": {
          "type": "string",
          "description": "Video stream URL"
        },
        "duration": {
          "type": "string",
          "description": "Video duration in mm:ss"
        },
        "instagramUrl": {
          "type": "string",
          "description": "Direct Instagram permalink"
        },
        "sortOrder": {
          "type": "number",
          "description": "Display order"
        },
        "createdAt": {
          "type": "string",
          "description": "Publication timestamp"
        }
      },
      "required": ["id", "title", "instagramUrl"]
    },
    "SiteSetting": {
      "title": "SiteSetting",
      "description": "Global application setting or toggle",
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "Setting key identifier"
        },
        "value": {
          "type": "string",
          "description": "Setting value or JSON payload"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp"
        }
      },
      "required": ["key", "value"]
    },
    "Assessment": {
      "title": "Assessment",
      "description": "Health resilience clinical assessment questionnaire submission",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique assessment submission ID"
        },
        "overall": {
          "type": "number",
          "description": "Overall score out of 100"
        },
        "domains": {
          "type": "object",
          "description": "Domain scores for gut, breath, hormone, sleep"
        },
        "answers": {
          "type": "array",
          "description": "Array of question point answers"
        },
        "clientEmail": {
          "type": "string",
          "description": "Optional email of respondent"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of submission"
        }
      },
      "required": ["id", "overall", "createdAt"]
    }
  },
  "firestore": {
    "/clients/{clientId}": {
      "schema": { "$ref": "#/entities/Client" },
      "description": "Client profile records"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Consultation appointments"
    },
    "/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/Session" },
      "description": "Clinical consultation notes and care plans"
    },
    "/breath_protocols/{protocolId}": {
      "schema": { "$ref": "#/entities/BreathProtocol" },
      "description": "Breathing pacer protocols"
    },
    "/instagram_reels/{reelId}": {
      "schema": { "$ref": "#/entities/InstagramReel" },
      "description": "Curated clinical Instagram reels feed"
    },
    "/site_settings/{settingKey}": {
      "schema": { "$ref": "#/entities/SiteSetting" },
      "description": "Platform settings and configurations"
    },
    "/assessments/{assessmentId}": {
      "schema": { "$ref": "#/entities/Assessment" },
      "description": "Health resilience audit submissions"
    }
  }
}

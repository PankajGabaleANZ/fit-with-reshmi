# Your actual Google Calendar email address (or "primary" if using OAuth Mode)
GOOGLE_CALENDAR_ID=primary

# ==============================================================
# MODE A: Personal Gmail Account (@gmail.com) via OAuth2 Token
# ==============================================================
# 1. Create OAuth Client ID (Web Application) in GCP
# 2. Add https://developers.google.com/oauthplayground to Authorized redirect URIs
# 3. Use OAuth Playground to authorize scopes: 
#    https://www.googleapis.com/auth/calendar.events, https://www.googleapis.com/auth/calendar.readonly
# 4. Exchange authorization code for tokens, check "Auto-refresh the token before it expires"
# 5. Copy the Refresh Token here:
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==============================================================
# MODE B: Google Workspace Users via Service Account (Optional)
# ==============================================================
# Download the service account key JSON from Google Cloud Console.
# Share your calendar with the service account email.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Replace normal newlines with \n when placing in this env file
GOOGLE_PRIVATE_KEY=

# ==============================================================
# RAZORPAY PAYMENT GATEWAY
# ==============================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
VITE_RAZORPAY_KEY_ID=

# ==============================================================
# GEMINI API (SERVER-SIDE ONLY)
# ==============================================================
GEMINI_API_KEY=

# ==============================================================
# ADMIN LOGIN & SESSIONS (REQUIRED for the admin portal to work)
# ==============================================================
ADMIN_USERNAME=
# Generate with: npm run hash-password -- "your long password"
# (paste the whole output, which starts with scrypt$). Do not put the plain password here.
ADMIN_PASSWORD_HASH=
# Long random text used to sign login cookies, e.g. output of: openssl rand -hex 32
# If missing, a temporary one is used and everyone is signed out on each restart.
SESSION_SECRET=
# Optional: only if your Firebase project differs from firebase-applet-config.json
FIREBASE_PROJECT_ID=

# ==============================================================
# DATABASE (Cloud Firestore, accessed only by the server)
# ==============================================================
# Defaults come from firebase-applet-config.json, so these are normally left empty.
# On Google Cloud the server signs in automatically (no key file needed); the service account
# needs the "Cloud Datastore User" role.
FIRESTORE_DATABASE_ID=
# For local testing against the Firestore emulator: FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
